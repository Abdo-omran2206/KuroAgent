# =======================================================
# KURO 2.0 Configuration Template
# =======================================================

# Provider Selection: gemini | groq | openrouter | ollama | openai
KURO_PROVIDER=gemini

# -------------------------------------------------------
# LLM API Keys & Multi-Key Pools (Comma-separated for key rotation)
# -------------------------------------------------------
# 1. Google Gemini (Default Free Tier - https://aistudio.google.com/app/apikey)
# GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_API_KEYS=key1,key2,key3

# 2. Groq (Fast Free Tier - https://console.groq.com/keys)
# GROQ_API_KEY=your_groq_api_key_here

# 3. OpenRouter (Free/Paid Models - https://openrouter.ai/keys)
# OPENROUTER_API_KEY=your_openrouter_api_key_here

# 4. Ollama (Local LLMs - no key required)
OLLAMA_BASE_URL=http://localhost:11434/v1

# 5. OpenAI (Optional)
# OPENAI_API_KEY=your_openai_api_key_here

# -------------------------------------------------------
# Autonomous Agent & Safety Settings
# -------------------------------------------------------
KURO_MAX_STEPS=10
KURO_SAFE_MODE=true
KURO_GIT_CHECKPOINTS=true
KURO_MAX_MEMORY=25
